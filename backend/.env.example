# MongoDB connection string
# DEV: mongodb+srv://<user>:<password>@<cluster>/ats_dev
# PROD: mongodb+srv://<user>:<password>@<cluster>/ats_prod
MONGO_URI=

# Server
PORT=5004

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Email (Resend)
EMAIL_ENABLED=true
RESEND_API_KEY=
EMAIL_FROM=

# Google Drive / Naukri ETL
DRIVE_SYNC_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
GOOGLE_DRIVE_FOLDER_ID=
NAUKRI_API_ENABLED=false
NAUKRI_API_KEY=
NAUKRI_RECRUITER_ID=
NAUKRI_API_URL=

# Google Form outreach + sync
FORM_SYNC_ENABLED=false
GOOGLE_FORM_URL=
GOOGLE_FORM_EMAIL_ENTRY_ID=
GOOGLE_FORM_RESPONSE_SHEET_ID=

# LinkedIn
LINKEDIN_API_ENABLED=false
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_ID=
COMPANY_CAREERS_URL=

# Data retention
RETENTION_ENABLED=false
RETENTION_DAYS=180
RETENTION_MODE=anonymize

# Calendly (FREELANCE CODING — Calendly Link Status)
# Optional. When enabled and a token is present, the ATS looks up each
# candidate's email against Calendly scheduled events and marks them
# "Booked"/"Not Booked" automatically. When disabled the recruiter selects
# the value manually from the dropdown instead.
#
# To find your URIs: set the first two values, then run
#   npm run calendly:whoami
CALENDLY_API_ENABLED=false
CALENDLY_API_TOKEN=
# Several Calendly accounts (e.g. separate Hiring / HR / Annotators logins): one personal access token per
# account, comma-separated. A token only sees its own account's bookings, so every account whose booking
# links you send needs one. Added to CALENDLY_API_TOKEN if that is also set.
CALENDLY_API_TOKENS=
# Optional — both are auto-discovered from GET /users/me if left blank.
# Setting CALENDLY_ORGANIZATION is recommended: it matches bookings made with
# ANY team member, not just the token owner.
CALENDLY_USER_URI=
CALENDLY_ORGANIZATION=
CALENDLY_API_URL=https://api.calendly.com

# --- Resume Analyzer ---
# With a key set, the ATS scores resumes by calling Anthropic directly (Claude Haiku 5.5): no cold
# start, no dependency on the separate screener service. Without it, scoring goes through the
# screener at bta-resume-screener.onrender.com, which sleeps when idle.
ANTHROPIC_API_KEY=
